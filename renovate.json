{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Kotlin と kotlinx の更新は CI 通過後に自動マージする",
      "matchPackagePrefixes": [
        "org.jetbrains.kotlin",
        "org.jetbrains.kotlinx"
      ],
      "automerge": true
    }
  ]
}
